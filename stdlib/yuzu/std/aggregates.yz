import yuzu.target.datafusion as datafusion
from yuzu.std.math import Numeric

pub agg def sum[T](x: T) -> T where T: Numeric {
    return datafusion.sum(x)
}

pub agg def min[T](x: T) -> T {
    return datafusion.min(x)
}

pub agg def max[T](x: T) -> T {
    return datafusion.max(x)
}

pub agg def avg[T](x: T) -> T where T: Numeric {
    return datafusion.avg(x)
}

pub agg def count() -> int64 {
    return datafusion.count()
}

pub agg def count[T](x: T) -> int64 {
    return datafusion.count(x)
}

pub agg def count_distinct[T](x: T) -> int64 {
    return datafusion.count_distinct(x)
}
