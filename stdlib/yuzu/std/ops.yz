import yuzu.target.datafusion as datafusion
from yuzu.std.math import Numeric

pub def add[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.add(a, b)
}

pub def sub[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.subtract(a, b)
}

pub def mul[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.multiply(a, b)
}

pub def div[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.divide(a, b)
}

pub def neg[T](a: T) -> T where T: Numeric {
    return datafusion.negate(a)
}

pub def modulo[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.modulus(a, b)
}

pub def pow[T](a: T, b: T) -> T where T: Numeric {
    return datafusion.power(a, b)
}

pub def shift_left(a: int64, b: int64) -> int64 {
    return datafusion.bitwise_shift_left(a, b)
}

pub def shift_right(a: int64, b: int64) -> int64 {
    return datafusion.bitwise_shift_right(a, b)
}

pub def eq[T](a: T, b: T) -> bool {
    return datafusion.equal(a, b)
}

pub def ne[T](a: T, b: T) -> bool {
    return datafusion.not_equal(a, b)
}

pub def lt[T](a: T, b: T) -> bool {
    return datafusion.lt(a, b)
}

pub def le[T](a: T, b: T) -> bool {
    return datafusion.lte(a, b)
}

pub def gt[T](a: T, b: T) -> bool {
    return datafusion.gt(a, b)
}

pub def ge[T](a: T, b: T) -> bool {
    return datafusion.gte(a, b)
}

pub def and(a: bool, b: bool) -> bool {
    return datafusion.and(a, b)
}

pub def or(a: bool, b: bool) -> bool {
    return datafusion.or(a, b)
}

pub def not(a: bool) -> bool {
    return datafusion.not(a)
}
